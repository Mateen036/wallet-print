# Robinhood Chain MAINNET (chain 4663). For testnet use:
#   VITE_RPC_URL=https://rpc.testnet.chain.robinhood.com
#   VITE_CHAIN_ID=46630
#   VITE_CHAIN_NAME=Robinhood Chain Testnet
#   VITE_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
#   VITE_IS_TESTNET=true
#
# Use a dedicated RPC provider (Alchemy, QuickNode, ...) for production. The
# public RPC is rate limited. VITE_ variables are visible in the browser, so
# restrict the provider key by domain.
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
VITE_CHAIN_ID=4663
VITE_CHAIN_NAME=Robinhood Chain
VITE_EXPLORER_URL=https://robin.etherscan.io
VITE_IS_TESTNET=false
VITE_WALLET_PRINT_ADDRESS=0xF391057A5C8C5045b84147560dDE7Ef609625f8E
VITE_SITE_URL=https://your-vercel-domain.vercel.app

# Footer links. Leave empty to hide a link.
VITE_OPENSEA_URL=
VITE_X_URL=
